rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getAdminData() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data
        : null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.admin == true
      );
    }

    function isOwner() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner') ||
        request.auth.token.role == 'owner'
      );
    }

    function isEditorOrOwner() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner' ||
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'editor')) ||
        request.auth.token.role == 'owner' ||
        request.auth.token.role == 'editor'
      );
    }

    // Public read for live/published catalog products
    match /products/{productId} {
      allow read: if (resource.data.status == 'live' ||
                      (resource.data.status == 'scheduled' && resource.data.publishAt <= request.time.toMillis()) ||
                      isAdmin());
      allow create, update: if isEditorOrOwner();
      allow delete: if isOwner();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow create, update: if isEditorOrOwner();
      allow delete: if isOwner();
    }

    // Collections & Drops
    match /collections/{collectionId} {
      allow read: if resource.data.status != 'draft' || isAdmin();
      allow create, update: if isEditorOrOwner();
      allow delete: if isOwner();
    }

    // Content (Homepage CMS, announcements, journal)
    match /content/{contentId} {
      allow read: if true;
      allow create, update: if isEditorOrOwner();
      allow delete: if isOwner();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if (isSignedIn() && resource.data.customer.id == request.auth.uid) || isAdmin();
      allow create: if true; // Guest or signed-in customer placing order
      allow update: if isEditorOrOwner();
      allow delete: if isOwner();
    }

    // Customers
    match /customers/{customerId} {
      allow read, write: if (isSignedIn() && customerId == request.auth.uid) || isAdmin();
    }

    // Waitlist
    match /waitlist/{waitlistId} {
      allow create: if request.resource.data.email is string && request.resource.data.email.size() > 3;
      allow read, update, delete: if isAdmin();
    }

    // Discounts
    match /discounts/{discountId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update: if isEditorOrOwner();
      allow delete: if isOwner();
    }

    // Store Settings
    match /settings/{settingsId} {
      allow read: if true; // Public needs shipping rates, free shipping threshold & consent text
      allow write: if isOwner();
    }

    // Inventory & Audit Logs
    match /inventoryLog/{logId} {
      allow read: if isAdmin();
      allow create: if isEditorOrOwner();
      allow update, delete: if false; // Immutable audit trail
    }

    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit trail
    }

    // Admins management (Owner only)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    // Anonymous Behavior Tracking Events (Create-only by anyone, never public-readable)
    match /events/{eventId} {
      allow create: if request.resource.data.type is string &&
                       request.resource.data.timestamp is number &&
                       request.resource.data.sessionId is string;
      allow read, update, delete: if isAdmin();
    }

    // Aggregated Daily Stats & AI Insights
    match /dailyStats/{statId} {
      allow read: if isAdmin();
      allow write: if isEditorOrOwner();
    }

    match /insights/{insightId} {
      allow read: if isAdmin();
      allow write: if isEditorOrOwner();
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper to check if requester is an authenticated admin
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'almurtazascoutsdata@gmail.com' ||
        request.auth.token.email == 'huxaifa0fficial@gmail.com' ||
        request.auth.token.email == 'owner@zejesh.fi' ||
        request.auth.token.admin == true ||
        request.auth.token.role == 'owner' ||
        request.auth.token.role == 'editor'
      );
    }

    // Public read for all catalog, lookbook, and campaign media
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 25 * 1024 * 1024; // 25MB max
    }

    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 100 * 1024 * 1024; // 100MB max
    }

    match /content/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fallback rule
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

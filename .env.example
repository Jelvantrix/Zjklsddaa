# ===========================================================================
# Supabase
# ===========================================================================
# Dashboard -> Project Settings -> API
# The anon key is safe to expose in client code: every query it makes is
# subject to Row Level Security (see supabase/migrations/0002).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. NEVER prefix this with VITE_ — Vite inlines VITE_* variables
# into the browser bundle, and this key bypasses Row Level Security entirely.
# server.ts refuses to serve /api without it (all routes require an admin JWT).
SUPABASE_SERVICE_ROLE_KEY=

# ===========================================================================
# Gemini AI for Video Generation (server side only)
# ===========================================================================
GEMINI_API_KEY=

# ===========================================================================
# Server
# ===========================================================================
PORT=3000

# Set only when running behind a reverse proxy (nginx, Cloudflare, Vercel...).
# Enables correct client IPs for rate limiting. Omit when running bare.
# Number = how many proxies to trust (1 for a single proxy).
TRUST_PROXY=

# ===========================================================================
# Demo Mode - WARNING: ONLY SET TO true IN DEVELOPMENT
# When true, seeds targets system with demo data marked isDemo=true
# In production, this must be false or unset to prevent fake data
# ===========================================================================
DEMO_MODE=false

{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Numbered luxury garment in the Zejesh archival collection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nr": { "type": "string" },
        "name": { "type": "object" },
        "description": { "type": "object" },
        "material": { "type": "object" },
        "origin": { "type": "string" },
        "care": { "type": "object" },
        "price": { "type": "number" },
        "compareAtPrice": { "type": "number" },
        "vatRate": { "type": "number" },
        "categoryIds": { "type": "array" },
        "collectionIds": { "type": "array" },
        "variants": { "type": "array" },
        "images": { "type": "array" },
        "status": { "type": "string", "enum": ["draft", "scheduled", "live", "sold_out", "archived"] },
        "publishAt": { "type": "string" },
        "limitedEdition": { "type": "object" },
        "seo": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "nr", "price", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Hierarchical category node with bilingual name and slug",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "parentId": { "type": "string" },
        "name": { "type": "object" },
        "slug": { "type": "string" },
        "image": { "type": "string" },
        "order": { "type": "number" },
        "visible": { "type": "boolean" }
      },
      "required": ["id", "slug", "visible"]
    },
    "Collection": {
      "title": "Collection",
      "description": "Season, Drop, or Essentials thematic grouping",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "type": { "type": "string", "enum": ["season", "drop", "essentials"] },
        "startAt": { "type": "string" },
        "endAt": { "type": "string" },
        "editionSize": { "type": "number" },
        "status": { "type": "string" },
        "cover": { "type": "string" }
      },
      "required": ["id", "name", "slug", "type"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "string" },
        "customer": { "type": "object" },
        "items": { "type": "array" },
        "totals": { "type": "object" },
        "status": { "type": "string", "enum": ["new", "paid", "packed", "shipped", "delivered", "cancelled", "refunded"] },
        "shippingMethod": { "type": "string" },
        "tracking": { "type": "string" },
        "notes": { "type": "string" },
        "timeline": { "type": "array" }
      },
      "required": ["id", "number", "totals", "status"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer profile and order summary",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "marketingConsent": { "type": "boolean" },
        "wishlist": { "type": "array" },
        "totals": { "type": "object" },
        "firstSeen": { "type": "string" },
        "lastSeen": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Waitlist": {
      "title": "Waitlist",
      "description": "Drop waitlist signup",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "source": { "type": "string" },
        "dropId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Discount": {
      "title": "Discount",
      "description": "Promotional or archival discount coupon",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "type": { "type": "string", "enum": ["percent", "fixed", "freeShipping"] },
        "value": { "type": "number" },
        "minSpend": { "type": "number" },
        "usageLimit": { "type": "number" },
        "used": { "type": "number" },
        "startAt": { "type": "string" },
        "endAt": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "code", "type", "active"]
    },
    "Content": {
      "title": "Content",
      "description": "Storefront configuration, hero media, announcements, journal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "heroMedia": { "type": "object" },
        "announcementBar": { "type": "object" },
        "sectionOrder": { "type": "array" },
        "journalPosts": { "type": "array" },
        "translations": { "type": "object" }
      },
      "required": ["id"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global storefront and commerce configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeInfo": { "type": "object" },
        "shippingRates": { "type": "array" },
        "freeShippingThreshold": { "type": "number" },
        "vatRate": { "type": "number" },
        "consentText": { "type": "object" },
        "lowStockThreshold": { "type": "number" }
      },
      "required": ["id"]
    },
    "InventoryLog": {
      "title": "InventoryLog",
      "description": "Audit record of stock adjustments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "size": { "type": "string" },
        "delta": { "type": "number" },
        "reason": { "type": "string" },
        "by": { "type": "string" },
        "at": { "type": "string" }
      },
      "required": ["id", "productId", "delta", "at"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Administrative actions audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "who": { "type": "string" },
        "action": { "type": "string" },
        "target": { "type": "string" },
        "at": { "type": "string" }
      },
      "required": ["id", "who", "action", "at"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Staff member with role-based access",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "editor", "viewer"] }
      },
      "required": ["id", "role"]
    },
    "TrackingEvent": {
      "title": "TrackingEvent",
      "description": "Anonymous behavior event for aggregate analytics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "timestamp": { "type": "number" },
        "sessionId": { "type": "string" },
        "page": { "type": "string" },
        "deviceClass": { "type": "string" },
        "viewport": { "type": "object" },
        "language": { "type": "string" }
      },
      "required": ["id", "type", "timestamp", "sessionId"]
    },
    "DailyStat": {
      "title": "DailyStat",
      "description": "Aggregated daily metrics slice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "visitors": { "type": "number" },
        "revenue": { "type": "number" },
        "orders": { "type": "number" }
      },
      "required": ["id", "date"]
    },
    "Insight": {
      "title": "Insight",
      "description": "Strategic AI & rule-based commerce recommendations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "category": { "type": "string" },
        "evidence": { "type": "string" },
        "recommendation": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "in_progress", "done", "dismissed"] }
      },
      "required": ["id", "title", "priority", "status"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Published and archival garments"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Storefront taxonomy tree"
    },
    "/collections/{collectionId}": {
      "schema": "Collection",
      "description": "Seasons, drops, and essentials"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Storefront orders and fulfillment records"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Registered and guest customers"
    },
    "/waitlist/{waitlistId}": {
      "schema": "Waitlist",
      "description": "Drop waitlist registrations"
    },
    "/discounts/{discountId}": {
      "schema": "Discount",
      "description": "Promotion coupons"
    },
    "/content/{contentId}": {
      "schema": "Content",
      "description": "Storefront homepage and journal CMS"
    },
    "/settings/{settingsId}": {
      "schema": "Settings",
      "description": "Store commerce settings"
    },
    "/inventoryLog/{logId}": {
      "schema": "InventoryLog",
      "description": "Stock change history"
    },
    "/auditLog/{logId}": {
      "schema": "AuditLog",
      "description": "Administrative audit trail"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Role-based permissions"
    },
    "/events/{eventId}": {
      "schema": "TrackingEvent",
      "description": "Create-only anonymous behavior logs"
    },
    "/dailyStats/{statId}": {
      "schema": "DailyStat",
      "description": "Aggregated analytics summaries"
    },
    "/insights/{insightId}": {
      "schema": "Insight",
      "description": "AI & rule-based advisor cards"
    }
  }
}
